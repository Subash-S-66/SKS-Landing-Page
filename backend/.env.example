# Server Setup
PORT=5000
FRONTEND_URL=http://localhost:3000

# Security (Important: Keep this secret in production)
JWT_SECRET=your_super_secret_jwt_key_here
INTERNAL_API_TOKEN=your_internal_proxy_token_here_for_nextjs

# Database
MONGODB_URI=mongodb://localhost:27017/sks-services

# Cloudinary (Image Uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Email (Nodemailer - Used for sending admin alerts and client confirmations)
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
ADMIN_EMAIL=your_email@gmail.com
